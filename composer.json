{
	"name": "your-vendor/golive-audit",
	"description": "Launch-readiness and client-handoff audit for WordPress sites.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"GoliveAudit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GoliveAudit\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
