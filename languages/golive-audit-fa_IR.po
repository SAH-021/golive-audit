#. Plugin Name of the plugin
#: golive-audit.php
msgid "Golive Audit"
msgstr "گو-لایو آدیت"

#. Description of the plugin
#: golive-audit.php
msgid "Launch-readiness and client-handoff audit for WordPress sites: environment-aware checks, run history, scheduled audits, Persian support and client-ready reports."
msgstr "بررسی آمادگی انتشار و تحویل پروژه برای سایت‌های وردپرس: بررسی‌های وابسته به محیط، تاریخچه‌ی اجرا، ممیزی زمان‌بندی‌شده، پشتیبانی از فارسی و گزارش‌های آماده‌ی ارائه به کارفرما."

#: src/Admin/AdminPage.php:46
msgid "The dashboard has not been built. Run \"npm install && npm run build\" in the plugin folder."
msgstr "داشبورد ساخته نشده است. در پوشه‌ی افزونه دستور «npm install && npm run build» را اجرا کنید."

#: src/Admin/AdminPage.php:53
msgid "Golive Audit needs JavaScript. You can still use WP-CLI: wp golive-audit run"
msgstr "گو-لایو آدیت به جاوااسکریپت نیاز دارد. همچنان می‌توانید از WP-CLI استفاده کنید: wp golive-audit run"

#: src/Admin/ExportHandler.php:34
msgid "You are not allowed to export this report."
msgstr "اجازه‌ی دریافت خروجی این گزارش را ندارید."

#: src/Admin/ExportHandler.php:43
msgid "Unknown export format."
msgstr "قالب خروجی ناشناخته است."

#. translators: %s: environment name, e.g. "local".
#: src/Audit/AuditRunner.php:48
#, php-format
msgid "Not applicable to the \"%s\" environment."
msgstr "برای محیط «%s» کاربرد ندارد."

#: src/Audit/Categories.php:17
msgid "SEO & visibility"
msgstr "سئو و دیده‌شدن"

#: src/Audit/Categories.php:18
msgid "Environment & URLs"
msgstr "محیط و نشانی‌ها"

#: src/Audit/Categories.php:19
msgid "Content"
msgstr "محتوا"

#: src/Audit/Categories.php:20
msgid "Privacy & legal"
msgstr "حریم خصوصی و قوانین"

#: src/Audit/Categories.php:21
msgid "Security basics"
msgstr "امنیت پایه"

#: src/Audit/Categories.php:22
msgid "Email"
msgstr "ایمیل"

#: src/Audit/Categories.php:23
msgid "Language & region"
msgstr "زبان و منطقه"

#. translators: %s: short error code.
#: src/Audit/Result.php:80
#, php-format
msgid "This check could not be completed (%s)."
msgstr "این بررسی کامل نشد (%s)."

#: src/Checklist/Catalog.php:22
msgid "Business / brochure site"
msgstr "سایت شرکتی / معرفی"

#: src/Checklist/Catalog.php:23
msgid "Blog / publication"
msgstr "وبلاگ / نشریه"

#: src/Checklist/Catalog.php:24
msgid "Online shop"
msgstr "فروشگاه آنلاین"

#: src/Checklist/Catalog.php:33
msgid "Infrastructure"
msgstr "زیرساخت"

#: src/Checklist/Catalog.php:34
msgid "Quality assurance"
msgstr "کنترل کیفیت"

#: src/Checklist/Catalog.php:35
msgid "Privacy & compliance"
msgstr "حریم خصوصی و انطباق"

#: src/Checklist/Catalog.php:36
msgid "Handover"
msgstr "تحویل پروژه"

#: src/Checklist/Catalog.php:78
msgid "A full backup exists and a restore has been tested"
msgstr "یک نسخه‌ی پشتیبان کامل وجود دارد و بازیابی آن آزمایش شده است"

#: src/Checklist/Catalog.php:83
msgid "DNS is configured and the SSL certificate renews automatically"
msgstr "دی‌ان‌اس تنظیم شده و گواهی SSL به‌صورت خودکار تمدید می‌شود"

#: src/Checklist/Catalog.php:88
msgid "Redirects from the old site's URLs are in place (for redesigns)"
msgstr "ریدایرکت نشانی‌های سایت قبلی انجام شده است (برای بازطراحی‌ها)"

#: src/Checklist/Catalog.php:93
msgid "Every form was submitted and the notification emails arrived"
msgstr "همه‌ی فرم‌ها ارسال و آزمایش شده و ایمیل‌های اطلاع‌رسانی رسیده‌اند"

#: src/Checklist/Catalog.php:98
msgid "The site was tested in the main browsers and on mobile"
msgstr "سایت در مرورگرهای اصلی و روی موبایل آزمایش شده است"

#: src/Checklist/Catalog.php:103
msgid "A helpful 404 page exists"
msgstr "صفحه‌ی ۴۰۴ کاربردی وجود دارد"

#: src/Checklist/Catalog.php:108
msgid "Analytics and Search Console are set up"
msgstr "آنالیتیکس و سرچ کنسول راه‌اندازی شده‌اند"

#: src/Checklist/Catalog.php:113
msgid "Automatic backups are scheduled and stored off the server"
msgstr "پشتیبان‌گیری خودکار زمان‌بندی شده و نسخه‌ها خارج از سرور نگهداری می‌شوند"

#: src/Checklist/Catalog.php:118
msgid "Uptime monitoring and failure alerts are set up"
msgstr "پایش در دسترس‌بودن سایت و هشدار خرابی راه‌اندازی شده است"

#: src/Checklist/Catalog.php:123
msgid "Old staging or test copies are password-protected or removed"
msgstr "نسخه‌های قدیمی آزمایشی یا استیجینگ رمزگذاری یا حذف شده‌اند"

#: src/Checklist/Catalog.php:128
msgid "SPF, DKIM and DMARC are configured for the sending domain"
msgstr "SPF، DKIM و DMARC برای دامنه‌ی ارسال‌کننده‌ی ایمیل تنظیم شده‌اند"

#: src/Checklist/Catalog.php:133
msgid "Page speed was tested on mobile and the worst offenders fixed"
msgstr "سرعت صفحات روی موبایل سنجیده و موارد مشکل‌ساز رفع شده‌اند"

#: src/Checklist/Catalog.php:138
msgid "Link previews were tested on social networks and messengers"
msgstr "پیش‌نمایش لینک در شبکه‌های اجتماعی و پیام‌رسان‌ها آزمایش شده است"

#: src/Checklist/Catalog.php:143
msgid "The XML sitemap is submitted to Search Console"
msgstr "نقشه‌ی XML سایت در سرچ کنسول ثبت شده است"

#: src/Checklist/Catalog.php:148
msgid "Caches (plugin, server and CDN) were cleared after the final changes"
msgstr "کش‌ها (افزونه، سرور و CDN) پس از آخرین تغییرات پاک شده‌اند"

#: src/Checklist/Catalog.php:153
msgid "Cookie consent and privacy requirements are handled for the target markets"
msgstr "رضایت کوکی و الزامات حریم خصوصی برای بازارهای هدف رعایت شده است"

#: src/Checklist/Catalog.php:158
msgid "Hosting, domain and admin credentials are handed over to the client"
msgstr "اطلاعات هاست، دامنه و دسترسی مدیر به کارفرما تحویل داده شده است"

#: src/Checklist/Catalog.php:163
msgid "The client was trained to edit content and knows who to contact for support"
msgstr "به کارفرما آموزش ویرایش محتوا داده شده و می‌داند برای پشتیبانی با چه کسی تماس بگیرد"

#: src/Checklist/Catalog.php:176
msgid "The RSS feed works and any newsletter sign-up is tested"
msgstr "فید RSS کار می‌کند و عضویت در خبرنامه (در صورت وجود) آزمایش شده است"

#: src/Checklist/Catalog.php:181
msgid "Author profiles, categories and tags have been reviewed"
msgstr "صفحه‌ی نویسندگان، دسته‌ها و برچسب‌ها بازبینی شده‌اند"

#: src/Checklist/Catalog.php:194
msgid "The payment gateway is in live mode and a real test order was placed"
msgstr "درگاه پرداخت در حالت واقعی است و یک سفارش آزمایشی واقعی ثبت شده است"

#: src/Checklist/Catalog.php:199
msgid "Terms, returns and shipping pages are published"
msgstr "صفحه‌های قوانین، بازگشت کالا و ارسال منتشر شده‌اند"

#: src/Checklist/Catalog.php:204
msgid "Order and shipping emails were tested end to end"
msgstr "ایمیل‌های سفارش و ارسال از ابتدا تا انتها آزمایش شده‌اند"

#: src/Checklist/Catalog.php:209
msgid "Taxes, shipping zones and shipping rates were checked with real addresses"
msgstr "مالیات، مناطق ارسال و هزینه‌های ارسال با نشانی‌های واقعی بررسی شده‌اند"

#: src/Checklist/Catalog.php:214
msgid "Any required business registration or trust badge (for example Enamad in Iran) is displayed"
msgstr "مجوز یا نماد اعتماد موردنیاز (مثلاً اینماد در ایران) در سایت نمایش داده می‌شود"

#: src/Checks/AdminEmailCheck.php:33
msgid "Administration email address is real"
msgstr "ایمیل مدیر سایت واقعی است"

#: src/Checks/AdminEmailCheck.php:47
msgid "Set a monitored address in Settings > General so WordPress notifications reach the site owner."
msgstr "در تنظیمات > همگانی یک ایمیل پایش‌شده وارد کنید تا اعلان‌های وردپرس به مالک سایت برسد."

#: src/Checks/AdminEmailCheck.php:50
msgid "The administration email address is missing or invalid."
msgstr "ایمیل مدیر سایت خالی یا نامعتبر است."

#. translators: %s: email domain, e.g. "example.com".
#: src/Checks/AdminEmailCheck.php:59
#, php-format
msgid "The administration email address uses a placeholder or reserved domain (%s)."
msgstr "ایمیل مدیر سایت از یک دامنه‌ی نمونه یا رزروشده استفاده می‌کند (%s)."

#: src/Checks/AdminEmailCheck.php:67
msgid "The administration email address uses a non-placeholder domain."
msgstr "ایمیل مدیر سایت از دامنه‌ی نمونه استفاده نمی‌کند."

#: src/Checks/AdminUsersCheck.php:22
msgid "Administrator accounts are limited and not guessable"
msgstr "حساب‌های مدیر محدود و غیرقابل حدس هستند"

#: src/Checks/AdminUsersCheck.php:33
msgid "a user named \"admin\" exists"
msgstr "کاربری با نام «admin» وجود دارد"

#. translators: 1: number of administrators, 2: recommended maximum.
#: src/Checks/AdminUsersCheck.php:41
#, php-format
msgid "%1$d administrator accounts exist (more than %2$d)"
msgstr "%1$d حساب مدیر وجود دارد (بیش از %2$d)"

#: src/Checks/AdminUsersCheck.php:48
msgid "No \"admin\" user was found and the number of administrators is small."
msgstr "کاربری با نام «admin» پیدا نشد و تعداد مدیران کم است."

#. translators: %s: list of problems.
#: src/Checks/AdminUsersCheck.php:54
#, php-format
msgid "Account hygiene: %s."
msgstr "بهداشت حساب‌ها: %s."

#: src/Checks/AdminUsersCheck.php:57
msgid "Rename or replace the \"admin\" login and give people only the role they need."
msgstr "نام کاربری «admin» را تغییر دهید یا جایگزین کنید و به هر فرد فقط نقش موردنیازش را بدهید."

#: src/Checks/ComingSoonCheck.php:37
msgid "No coming-soon or maintenance page is active"
msgstr "صفحه‌ی «به‌زودی» یا تعمیر و نگهداری فعال نیست"

#: src/Checks/ComingSoonCheck.php:51
msgid "WooCommerce is set to \"coming soon\", so visitors do not see the shop."
msgstr "ووکامرس روی «به‌زودی» تنظیم شده است، پس بازدیدکنندگان فروشگاه را نمی‌بینند."

#: src/Checks/ComingSoonCheck.php:52
msgid "Set the site visibility to \"Live\" in WooCommerce > Settings > Site visibility."
msgstr "در ووکامرس > تنظیمات > نمایش سایت، وضعیت را روی «زنده» بگذارید."

#: src/Checks/ComingSoonCheck.php:60
msgid "A coming-soon or maintenance plugin is active."
msgstr "یک افزونه‌ی «به‌زودی» یا تعمیر و نگهداری فعال است."

#: src/Checks/ComingSoonCheck.php:61
msgid "Deactivate it, or make sure its coming-soon mode is switched off, so visitors see the real site."
msgstr "آن را غیرفعال کنید یا مطمئن شوید حالت «به‌زودی» آن خاموش است تا بازدیدکنندگان سایت واقعی را ببینند."

#: src/Checks/ComingSoonCheck.php:67
msgid "No coming-soon or maintenance plugin or setting was detected."
msgstr "هیچ افزونه یا تنظیمی برای صفحه‌ی «به‌زودی» یا تعمیر و نگهداری پیدا نشد."

#: src/Checks/CommentDefaultsCheck.php:20
msgid "Comment and pingback defaults are intentional"
msgstr "پیش‌فرض‌های دیدگاه و پینگ‌بک آگاهانه انتخاب شده‌اند"

#: src/Checks/CommentDefaultsCheck.php:31
msgid "pingbacks and trackbacks are enabled for new content"
msgstr "پینگ‌بک و ترک‌بک برای نوشته‌های جدید فعال است"

#: src/Checks/CommentDefaultsCheck.php:39
msgid "new comments are published without any moderation"
msgstr "دیدگاه‌های جدید بدون هیچ بررسی منتشر می‌شوند"

#: src/Checks/CommentDefaultsCheck.php:43
msgid "Comment and pingback defaults look intentional."
msgstr "پیش‌فرض‌های دیدگاه و پینگ‌بک آگاهانه به نظر می‌رسند."

#. translators: %s: list of problems.
#: src/Checks/CommentDefaultsCheck.php:49
#, php-format
msgid "Discussion defaults: %s."
msgstr "پیش‌فرض‌های گفتگو: %s."

#: src/Checks/CommentDefaultsCheck.php:52
msgid "Review Settings > Discussion: disable pingbacks unless needed and require moderation or a previously approved comment."
msgstr "تنظیمات > گفتگو را بررسی کنید: پینگ‌بک را در صورت نیاز نداشتن خاموش کنید و تأیید دیدگاه یا تأیید قبلی نویسنده را الزامی کنید."

#: src/Checks/DbPrefixCheck.php:20
msgid "The database table prefix is not the default"
msgstr "پیشوند جدول‌های پایگاه داده پیش‌فرض نیست"

#: src/Checks/DbPrefixCheck.php:29
msgid "A custom database table prefix is used."
msgstr "از پیشوند سفارشی برای جدول‌های پایگاه داده استفاده شده است."

#: src/Checks/DbPrefixCheck.php:33
msgid "The database table prefix is the default \"wp_\"."
msgstr "پیشوند جدول‌های پایگاه داده همان «wp_» پیش‌فرض است."

#: src/Checks/DbPrefixCheck.php:34
msgid "Choose a custom $table_prefix in wp-config.php on new installs. Renaming tables on a live site is risky, so accept the risk if the site is already running."
msgstr "در نصب‌های جدید یک $table_prefix سفارشی در wp-config.php انتخاب کنید. تغییر نام جدول‌ها در سایت زنده پرخطر است؛ اگر سایت از قبل فعال است، این ریسک را بپذیرید."

#: src/Checks/DebugLogCheck.php:23
msgid "No leftover debug.log in wp-content"
msgstr "فایل debug.log قدیمی در wp-content وجود ندارد"

#: src/Checks/DebugLogCheck.php:32
msgid "No debug.log file was found in wp-content."
msgstr "فایل debug.log در wp-content پیدا نشد."

#: src/Checks/DebugLogCheck.php:36
msgid "A debug.log file exists in wp-content."
msgstr "فایل debug.log در wp-content وجود دارد."

#: src/Checks/DebugLogCheck.php:37
msgid "Review and delete it, turn off WP_DEBUG_LOG on live sites, and make sure your server does not serve .log files."
msgstr "آن را بازبینی و حذف کنید، WP_DEBUG_LOG را روی سایت‌های زنده خاموش کنید و مطمئن شوید سرور فایل‌های .log را ارائه نمی‌دهد."

#: src/Checks/DefaultContentCheck.php:23
msgid "Default sample content has been removed"
msgstr "محتوای نمونه‌ی پیش‌فرض حذف شده است"

#: src/Checks/DefaultContentCheck.php:34
msgid "the \"Hello world!\" post"
msgstr "نوشته‌ی «Hello world!»"

#: src/Checks/DefaultContentCheck.php:38
msgid "the \"Sample Page\" page"
msgstr "برگه‌ی «Sample Page»"

#: src/Checks/DefaultContentCheck.php:42
msgid "No default sample content was found."
msgstr "هیچ محتوای نمونه‌ی پیش‌فرضی پیدا نشد."

#. translators: %s: list of leftover items, e.g. 'the "Hello world!" post, the "Sample Page" page'.
#: src/Checks/DefaultContentCheck.php:48
#, php-format
msgid "Published sample content is still present: %s."
msgstr "محتوای نمونه‌ی منتشرشده هنوز وجود دارد: %s."

#: src/Checks/DefaultContentCheck.php:51
msgid "Delete or replace the default sample post and page before launch."
msgstr "پیش از انتشار سایت، نوشته و برگه‌ی نمونه‌ی پیش‌فرض را حذف یا جایگزین کنید."

#: src/Checks/FileEditorCheck.php:20
msgid "The dashboard file editor is disabled"
msgstr "ویرایشگر فایل در پیشخوان غیرفعال است"

#: src/Checks/FileEditorCheck.php:29
msgid "The dashboard file editor is disabled."
msgstr "ویرایشگر فایل در پیشخوان غیرفعال است."

#: src/Checks/FileEditorCheck.php:33
msgid "Administrators can edit theme and plugin code from the dashboard."
msgstr "مدیران می‌توانند کد پوسته و افزونه‌ها را از پیشخوان ویرایش کنند."

#: src/Checks/FileEditorCheck.php:34
msgid "Add define( 'DISALLOW_FILE_EDIT', true ); to wp-config.php so a compromised admin account cannot change code from the browser."
msgstr "دستور define( 'DISALLOW_FILE_EDIT', true ); را به wp-config.php اضافه کنید تا حساب مدیرِ نفوذشده نتواند از مرورگر کد را تغییر دهد."

#: src/Checks/FrontPageCheck.php:20
msgid "The front page is configured correctly"
msgstr "صفحه‌ی اصلی درست تنظیم شده است"

#: src/Checks/FrontPageCheck.php:29
msgid "The front page shows the latest posts."
msgstr "صفحه‌ی اصلی آخرین نوشته‌ها را نشان می‌دهد."

#: src/Checks/FrontPageCheck.php:36
msgid "The static front page is published."
msgstr "صفحه‌ی اصلی ایستا منتشر شده است."

#: src/Checks/FrontPageCheck.php:41
msgid "A static front page is enabled but no page is selected."
msgstr "صفحه‌ی اصلی ایستا فعال است اما هیچ برگه‌ای انتخاب نشده است."

#: src/Checks/FrontPageCheck.php:42
msgid "The selected static front page is missing or not published."
msgstr "برگه‌ی انتخاب‌شده به‌عنوان صفحه‌ی اصلی وجود ندارد یا منتشر نشده است."

#: src/Checks/FrontPageCheck.php:43
msgid "Pick a published page as the homepage in Settings > Reading."
msgstr "در تنظیمات > خواندن یک برگه‌ی منتشرشده را به‌عنوان صفحه‌ی اصلی انتخاب کنید."

#: src/Checks/LeftoverFilesCheck.php:22
msgid "Install leftovers are removed from the site root"
msgstr "باقی‌مانده‌های نصب از ریشه‌ی سایت حذف شده‌اند"

#: src/Checks/LeftoverFilesCheck.php:39
msgid "No install leftovers were found in the site root."
msgstr "هیچ باقی‌مانده‌ای از نصب در ریشه‌ی سایت پیدا نشد."

#. translators: %s: comma separated list of file names.
#: src/Checks/LeftoverFilesCheck.php:45
#, php-format
msgid "These files are still in the site root: %s."
msgstr "این فایل‌ها هنوز در ریشه‌ی سایت هستند: %s."

#: src/Checks/LeftoverFilesCheck.php:48
msgid "Delete them. readme.html and license.txt reveal the WordPress version, and error_log can expose paths and warnings."
msgstr "آن‌ها را حذف کنید. readme.html و license.txt نسخه‌ی وردپرس را فاش می‌کنند و error_log می‌تواند مسیرها و هشدارها را افشا کند."

#: src/Checks/MailTransportCheck.php:23
msgid "Outgoing email uses a configured transport"
msgstr "ایمیل خروجی از یک سرویس ارسال تنظیم‌شده استفاده می‌کند"

#: src/Checks/MailTransportCheck.php:36
msgid "A custom mail transport is configured. Delivery itself is not verified, so send a test message."
msgstr "یک سرویس ارسال ایمیل سفارشی تنظیم شده است. تحویل ایمیل بررسی نشده، پس یک پیام آزمایشی بفرستید."

#: src/Checks/MailTransportCheck.php:40
msgid "No custom mail transport was detected, so WordPress will use PHP mail()."
msgstr "هیچ سرویس ارسال ایمیل سفارشی شناسایی نشد، بنابراین وردپرس از mail() پی‌اچ‌پی استفاده می‌کند."

#: src/Checks/MailTransportCheck.php:41
msgid "Configure SMTP or a transactional email service and send a real test message, because form notifications and password resets often go missing otherwise."
msgstr "SMTP یا یک سرویس ایمیل تراکنشی تنظیم کنید و یک پیام آزمایشی واقعی بفرستید؛ در غیر این صورت اعلان فرم‌ها و بازیابی رمز عبور اغلب گم می‌شوند."

#: src/Checks/NoindexCheck.php:22
msgid "Search engine visibility matches the environment"
msgstr "نمایش در موتورهای جستجو با محیط سایت همخوان است"

#: src/Checks/NoindexCheck.php:41
msgid "Search engines are discouraged from indexing this production site."
msgstr "موتورهای جستجو از فهرست‌کردن این سایت اصلی منع شده‌اند."

#: src/Checks/NoindexCheck.php:42
msgid "Untick \"Discourage search engines from indexing this site\" in Settings > Reading. If this site is not production, set WP_ENVIRONMENT_TYPE or run the audit with another environment."
msgstr "در تنظیمات > خواندن تیک «جلوگیری از فهرست‌شدن توسط موتورهای جستجو» را بردارید. اگر این سایت محیط اصلی نیست، WP_ENVIRONMENT_TYPE را تنظیم کنید یا حالت بررسی را عوض کنید."

#: src/Checks/NoindexCheck.php:47
msgid "Search engines are allowed to index this production site."
msgstr "موتورهای جستجو اجازه دارند این سایت اصلی را فهرست کنند."

#. translators: %s: environment name, e.g. "staging".
#: src/Checks/NoindexCheck.php:54
#, php-format
msgid "Indexing is disabled, as expected for a \"%s\" environment."
msgstr "فهرست‌شدن غیرفعال است، که برای محیط «%s» مطابق انتظار است."

#. translators: %s: environment name, e.g. "staging".
#: src/Checks/NoindexCheck.php:63
#, php-format
msgid "This \"%s\" environment can be indexed by search engines."
msgstr "این محیط «%s» می‌تواند توسط موتورهای جستجو فهرست شود."

#: src/Checks/NoindexCheck.php:66
msgid "Enable \"Discourage search engines from indexing this site\" in Settings > Reading so test content does not appear in search results."
msgstr "در تنظیمات > خواندن گزینه‌ی «جلوگیری از فهرست‌شدن توسط موتورهای جستجو» را فعال کنید تا محتوای آزمایشی در نتایج جستجو ظاهر نشود."

#: src/Checks/OpenRegistrationCheck.php:22
msgid "Open registration does not grant privileged roles"
msgstr "ثبت‌نام آزاد نقش‌های دارای دسترسی بالا نمی‌دهد"

#: src/Checks/OpenRegistrationCheck.php:31
msgid "Public registration is disabled."
msgstr "ثبت‌نام عمومی غیرفعال است."

#. translators: %s: role name, e.g. "administrator".
#: src/Checks/OpenRegistrationCheck.php:40
#, php-format
msgid "Anyone can register and receives the \"%s\" role."
msgstr "هر کسی می‌تواند ثبت‌نام کند و نقش «%s» را می‌گیرد."

#: src/Checks/OpenRegistrationCheck.php:43
msgid "Set the new user default role to Subscriber (or disable registration) in Settings > General."
msgstr "نقش پیش‌فرض کاربران جدید را روی «مشترک» بگذارید (یا ثبت‌نام را غیرفعال کنید) در تنظیمات > همگانی."

#. translators: %s: role name, e.g. "subscriber".
#: src/Checks/OpenRegistrationCheck.php:51
#, php-format
msgid "Public registration is open, but new users only receive the \"%s\" role."
msgstr "ثبت‌نام عمومی باز است، اما کاربران جدید فقط نقش «%s» را می‌گیرند."

#: src/Checks/PermalinksCheck.php:20
msgid "Pretty permalinks are enabled"
msgstr "پیوندهای یکتای خوانا فعال هستند"

#: src/Checks/PermalinksCheck.php:29
msgid "The site uses a custom permalink structure."
msgstr "سایت از ساختار پیوند یکتای سفارشی استفاده می‌کند."

#: src/Checks/PermalinksCheck.php:33
msgid "The site uses plain permalinks such as ?p=123."
msgstr "سایت از پیوندهای ساده مثل ?p=123 استفاده می‌کند."

#: src/Checks/PermalinksCheck.php:34
msgid "Choose a descriptive structure (for example \"Post name\") in Settings > Permalinks. Set up redirects first if the site already has indexed URLs."
msgstr "در تنظیمات > پیوندهای یکتا یک ساختار توصیفی (مثلاً «نام نوشته») انتخاب کنید. اگر سایت نشانی‌های فهرست‌شده دارد، ابتدا ریدایرکت‌ها را آماده کنید."

#: src/Checks/PlaceholderTextCheck.php:26
msgid "No placeholder (lorem ipsum) text is published"
msgstr "هیچ متن نمونه‌ی (لورم ایپسوم) منتشر نشده است"

#: src/Checks/PlaceholderTextCheck.php:41
msgid "No published post or page contains lorem ipsum filler text."
msgstr "هیچ نوشته یا برگه‌ی منتشرشده‌ای متن نمونه‌ی لورم ایپسوم ندارد."

#. translators: %d: number of published posts or pages containing filler text.
#: src/Checks/PlaceholderTextCheck.php:47
#, php-format
msgid "%d published post or page still contains lorem ipsum filler text."
msgid_plural "%d published posts or pages still contain lorem ipsum filler text."
msgstr[0] "%d نوشته یا برگه‌ی منتشرشده هنوز متن نمونه‌ی لورم ایپسوم دارد."

#: src/Checks/PlaceholderTextCheck.php:55
msgid "Search your pages for \"lorem ipsum\", then replace the filler with real content or unpublish those pages before launch."
msgstr "عبارت «lorem ipsum» یا «لورم ایپسوم» را در برگه‌هایتان جست‌وجو کنید و متن نمونه را با محتوای واقعی عوض یا آن برگه‌ها را پیش‌نویس کنید."

#: src/Checks/PrivacyPolicyCheck.php:20
msgid "A privacy policy page is published"
msgstr "صفحه‌ی سیاست حفظ حریم خصوصی منتشر شده است"

#: src/Checks/PrivacyPolicyCheck.php:36
msgid "A privacy policy page is assigned and published."
msgstr "صفحه‌ی سیاست حفظ حریم خصوصی تعیین و منتشر شده است."

#: src/Checks/PrivacyPolicyCheck.php:41
msgid "No privacy policy page is assigned."
msgstr "هیچ صفحه‌ای به‌عنوان سیاست حفظ حریم خصوصی تعیین نشده است."

#: src/Checks/PrivacyPolicyCheck.php:42
msgid "The assigned privacy policy page is missing or not published."
msgstr "صفحه‌ی تعیین‌شده برای سیاست حفظ حریم خصوصی وجود ندارد یا منتشر نشده است."

#: src/Checks/PrivacyPolicyCheck.php:43
msgid "Write the policy (WordPress provides a template) and assign the published page in Settings > Privacy."
msgstr "سیاست را بنویسید (وردپرس یک الگو ارائه می‌دهد) و صفحه‌ی منتشرشده را در تنظیمات > حریم خصوصی تعیین کنید."

#: src/Checks/RobotsTxtCheck.php:20
msgid "robots.txt does not block the whole site"
msgstr "فایل robots.txt کل سایت را مسدود نمی‌کند"

#: src/Checks/RobotsTxtCheck.php:35
msgid "There is no physical robots.txt; WordPress serves its own, controlled by the search visibility setting."
msgstr "فایل robots.txt فیزیکی وجود ندارد؛ وردپرس فایل خودش را ارائه می‌دهد که با تنظیم دیده‌شدن در موتورهای جستجو کنترل می‌شود."

#: src/Checks/RobotsTxtCheck.php:40
msgid "robots.txt tells all crawlers to stay away from the entire site."
msgstr "فایل robots.txt به همه‌ی خزنده‌ها می‌گوید از کل سایت دور بمانند."

#: src/Checks/RobotsTxtCheck.php:41
msgid "Remove the \"Disallow: /\" rule for \"User-agent: *\" from the robots.txt file in the WordPress root."
msgstr "قانون «Disallow: /» مربوط به «User-agent: *» را از فایل robots.txt در ریشه‌ی وردپرس حذف کنید."

#: src/Checks/RobotsTxtCheck.php:45
msgid "robots.txt does not block the whole site."
msgstr "فایل robots.txt کل سایت را مسدود نمی‌کند."

#: src/Checks/SaltsCheck.php:35
msgid "Authentication keys and salts are unique"
msgstr "کلیدها و نمک‌های احراز هویت یکتا هستند"

#: src/Checks/SaltsCheck.php:55
msgid "All eight authentication keys and salts are defined."
msgstr "هر هشت کلید و نمک احراز هویت تعریف شده‌اند."

#. translators: %s: comma separated list of constant names.
#: src/Checks/SaltsCheck.php:61
#, php-format
msgid "These keys or salts are missing or still use the sample value: %s."
msgstr "این کلیدها یا نمک‌ها وجود ندارند یا هنوز مقدار نمونه دارند: %s."

#: src/Checks/SaltsCheck.php:64
msgid "Generate fresh values with the WordPress.org secret-key service and put them in wp-config.php. Existing sessions will be logged out."
msgstr "با سرویس تولید کلید امنیتی WordPress.org مقادیر تازه بسازید و در wp-config.php قرار دهید. نشست‌های فعلی خارج می‌شوند."

#: src/Checks/SensitiveFilesCheck.php:43
msgid "No backups, database dumps or debug scripts in the site root"
msgstr "فایل پشتیبان، خروجی پایگاه داده یا اسکریپت اشکال‌زدایی در ریشه‌ی سایت نیست"

#: src/Checks/SensitiveFilesCheck.php:60
msgid "No well-known backup, dump or debug files were found in the site root."
msgstr "هیچ فایل پشتیبان، خروجی پایگاه داده یا اسکریپت اشکال‌زدایی شناخته‌شده‌ای در ریشه‌ی سایت پیدا نشد."

#. translators: %s: comma separated list of file names.
#: src/Checks/SensitiveFilesCheck.php:66
#, php-format
msgid "Sensitive files exist in the site root: %s."
msgstr "فایل‌های حساس در ریشه‌ی سایت وجود دارند: %s."

#: src/Checks/SensitiveFilesCheck.php:69
msgid "Delete these files or move them outside the web root. A readable wp-config backup or SQL dump can expose database passwords and customer data."
msgstr "این فایل‌ها را حذف کنید یا به بیرون از ریشه‌ی وب منتقل کنید. پشتیبان قابل‌خواندنِ wp-config یا خروجی SQL می‌تواند رمزهای پایگاه داده و اطلاعات مشتریان را افشا کند."

#: src/Checks/SiteIconCheck.php:20
msgid "A site icon is set"
msgstr "نمادک سایت (فاوآیکون) تنظیم شده است"

#: src/Checks/SiteIconCheck.php:29
msgid "A site icon is set."
msgstr "نمادک سایت تنظیم شده است."

#: src/Checks/SiteIconCheck.php:33
msgid "No site icon is set, so browsers show a generic icon."
msgstr "نمادک سایت تنظیم نشده است، پس مرورگرها نماد عمومی نشان می‌دهند."

#: src/Checks/SiteIconCheck.php:34
msgid "Upload a square image of at least 512 x 512 pixels as the site icon in Appearance > Customize."
msgstr "در نمایش > سفارشی‌سازی یک تصویر مربع حداقل ۵۱۲ در ۵۱۲ پیکسل به‌عنوان نمادک سایت بارگذاری کنید."

#: src/Checks/SiteIdentityCheck.php:24
msgid "Site title and tagline are set"
msgstr "عنوان و توضیح کوتاه سایت تنظیم شده‌اند"

#: src/Checks/SiteIdentityCheck.php:35
msgid "the site title is empty"
msgstr "عنوان سایت خالی است"

#: src/Checks/SiteIdentityCheck.php:39
msgid "the tagline is still \"Just another WordPress site\""
msgstr "توضیح کوتاه هنوز «Just another WordPress site» است"

#: src/Checks/SiteIdentityCheck.php:43
msgid "The site has a title and no default tagline."
msgstr "سایت عنوان دارد و توضیح کوتاه پیش‌فرض ندارد."

#. translators: %s: list of problems.
#: src/Checks/SiteIdentityCheck.php:49
#, php-format
msgid "Site identity problems: %s."
msgstr "مشکلات هویت سایت: %s."

#: src/Checks/SiteIdentityCheck.php:52
msgid "Set a real title and tagline (or clear the tagline) in Settings > General."
msgstr "در تنظیمات > همگانی یک عنوان و توضیح کوتاه واقعی بنویسید (یا توضیح کوتاه را خالی کنید)."

#: src/Checks/SitemapCheck.php:34
msgid "An XML sitemap is available"
msgstr "نقشه‌ی XML سایت در دسترس است"

